# Local secrets for `wrangler dev` (do NOT commit).
# Copy to `.dev.vars` and fill in with long random values (openssl rand -hex 32).
# Never use placeholders like "change-me" in production.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
ADMIN_SECRET=

