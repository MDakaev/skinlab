{
  "name": "skinlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkinLab — Telegram bot + Mini App on Cloudflare Workers (sellable product)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply skinlab --local",
    "db:migrate:remote": "wrangler d1 migrations apply skinlab --remote",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.8.2",
    "wrangler": "4.13.2"
  },
  "engines": {
    "node": ">=20"
  }
}
