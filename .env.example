# SkinLab — переменные окружения
# Скопируйте в .env на сервере и заполните секреты вручную.
# Файл .env НЕ коммитить.

# --- Runtime (production за Nginx) ---
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
# LOG_LEVEL=info

# Публичный HTTPS origin сайта (без хвостового /).
# Нужен для checkout returnUrl fallback и документации.
# SKINLAB_PUBLIC_URL=https://example.com

# SQLite: на VDS предпочтительно вне репозитория.
# Локально можно оставить ./data/catalog.db
# SKINLAB_DB=/var/lib/skinlab/catalog.db

# --- Лицензии ---
SKINLAB_LICENSE_PRICE_RUB=1290

# DEV ONLY — не включайте на production.
# Если заданы YOOKASSA_* , checkout идёт в live и этот флаг для оплаты игнорируется,
# но /api/license/dev-issue всё равно открывается при =1.
# SKINLAB_DEV_LICENSES=1

# ЮKassa (live). Оба обязательны для приёма оплаты.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# --- Telegram (только backend) ---
# TELEGRAM_BOT_TOKEN=
# URL Mini App / Menu Button (обычно = SKINLAB_PUBLIC_URL)
# TELEGRAM_WEBAPP_URL=https://example.com
# SKINLAB_WEBAPP_URL=https://example.com

# --- Open Beauty Facts (опционально) ---
# OBF_BASE=https://world.openbeautyfacts.org
# OBF_UA=SkinLab/0.2 (contact: you@example.com)
