# SkinLab API / лицензии

# Порт API (по умолчанию 8787)
# PORT=8787
# HOST=127.0.0.1

# Разовая цена лицензии в рублях
SKINLAB_LICENSE_PRICE_RUB=1290

# Dev: checkout сразу выдаёт код без ЮKassa
SKINLAB_DEV_LICENSES=1

# ЮKassa (live). Если заданы — mode=live, SKINLAB_DEV_LICENSES игнорируется для checkout.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Путь к SQLite каталога (+ таблица licenses)
# SKINLAB_DB=./data/catalog.db

# Telegram Mini App / bot (только backend, никогда во frontend и не в Git)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBAPP_URL=https://mdakaev.github.io/skinlab/
